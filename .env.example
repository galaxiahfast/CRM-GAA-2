# --- ManagerControl (legacy, SOLO LECTURA) ---------------------------------
# Capture los valores reales SOLO en su .env local (nunca en este archivo ni en git).
# Use una cuenta con rol db_datareader únicamente; la app rechaza cuentas con permisos de escritura.
MANAGERCONTROL_HOST=
MANAGERCONTROL_INSTANCE=
MANAGERCONTROL_PORT=
MANAGERCONTROL_DATABASE=
MANAGERCONTROL_USERNAME=
MANAGERCONTROL_PASSWORD=
# Login de SQL Server de solo lectura (tiene prioridad sobre USERNAME/PASSWORD):
MANAGERCONTROL_SQL_USERNAME=
MANAGERCONTROL_SQL_PASSWORD=
MANAGERCONTROL_COMPANY_ID=1
MANAGERCONTROL_EXERCISE_ID=3
# Escritura (agregar/editar/dar de baja). Apagada hasta tener una cuenta solo para captura (docs/managercontrol-escritura.md):
MANAGERCONTROL_WRITE_ENABLED=false
# Envía las actividades del Cronómetro a ManagerControl (requiere la escritura activada)
MANAGERCONTROL_TIMER_SYNC_ENABLED=false
MANAGERCONTROL_TIMER_SYNC_FROM=2026-11-12
MANAGERCONTROL_WRITE_USERNAME=
MANAGERCONTROL_WRITE_PASSWORD=
# Importación separada de clientes, cuentas y actividades (docs/managercontrol-catalogos.md):
MANAGERCONTROL_CATALOG_WRITE_ENABLED=false
MANAGERCONTROL_CATALOG_WRITE_USERNAME=
MANAGERCONTROL_CATALOG_WRITE_PASSWORD=
# MANAGERCONTROL_HOURS_UNIT=hours   # hours | minutes | seconds | time

# Reloj checador biométrico (Hikvision ISAPI): lo usa biometric:sync cada minuto y a las 23:00
BIOMETRIC_IP=192.168.2.239
BIOMETRIC_USERNAME=admin
BIOMETRIC_PASSWORD=
