# --- ManagerControl (legacy, SOLO LECTURA) ---------------------------------
# Capture los valores reales SOLO en su .env local (nunca en este archivo ni en git).
# Use una cuenta con rol db_datareader únicamente; la app rechaza cuentas con permisos de escritura.
MANAGERCONTROL_HOST=
MANAGERCONTROL_INSTANCE=
MANAGERCONTROL_PORT=
MANAGERCONTROL_DATABASE=
MANAGERCONTROL_USERNAME=
MANAGERCONTROL_PASSWORD=
# Login de SQL Server de solo lectura (tiene prioridad sobre USERNAME/PASSWORD):
MANAGERCONTROL_SQL_USERNAME=
MANAGERCONTROL_SQL_PASSWORD=
# MANAGERCONTROL_EXERCISE_ID=
# MANAGERCONTROL_HOURS_UNIT=hours   # hours | minutes | seconds | time
